# ============================================================
# DATABASE — Get these from neon.tech (Free PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================================
# CLOUDINARY — Get these from cloudinary.com (Free Image CDN)
# ============================================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ============================================================
# AUTH — Keep this secret! Change this to a strong random string
# ============================================================
JWT_SECRET="change_this_to_a_very_long_random_secret_string_min_32_chars"

# ============================================================
# SITE URL — Your Vercel URL (update after deployment)
# ============================================================
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"
